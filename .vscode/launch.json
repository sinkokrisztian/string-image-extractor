{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OCR Report GUI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/ocr_report_gui.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "OCR Report: Prompt",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/image_ocr_match_report.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--root",
        "${workspaceFolder}",
        "--source-prefix",
        "enis",
        "--target-lang",
        "${input:targetLang}",
        "--source-ocr-lang",
        "eng",
        "--target-ocr-lang",
        "${input:targetOcrLang}",
        "--output",
        "${input:outputFile}",
        "--log-file",
        "${input:logFile}",
        "--ghostscript-cmd",
        "C:\\Program Files\\gs\\gs10.07.0\\bin\\gswin64c.exe",
        "--eps-dpi",
        "600",
        "--progress-every",
        "5",
        "--use-temp-local-copy",
        "--verbose"
      ]
    },
