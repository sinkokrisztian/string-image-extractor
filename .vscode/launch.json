  "inputs": [
    {
      "id": "targetLang",
      "type": "pickString",
      "description": "Target language code",
      "options": [
        "hu",
        "sk",
        "sl",
        "hr",
        "cz",
        "ro"
      ],
      "default": "hu"
    },
    {
      "id": "targetOcrLang",
      "type": "pickString",
      "description": "Tesseract OCR language code",
      "options": [
        "hun",
        "slk",
        "slv",
        "hrv",
        "ces",
        "ron"
      ],
      "default": "hun"
    },
    {
      "id": "outputFile",
      "type": "promptString",
      "description": "Output Excel filename",
      "default": "report_custom.xlsx"
    },
    {
      "id": "logFile",
      "type": "promptString",
      "description": "Log filename",
      "default": "report_custom.log"
    }
  ]
