            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>I am driving. I will call you back later.</photoshop:LayerName>
                  <photoshop:LayerText>I am driving. I will call you back later.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>I’m running late.</photoshop:LayerName>
                  <photoshop:LayerText>I’m running late.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>I will be there soon.</photoshop:LayerName>
                  <photoshop:LayerText>I will be there soon.</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
